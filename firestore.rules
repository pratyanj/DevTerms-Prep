rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidStringArray(arr) {
      return arr is list
        && arr.size() <= 100
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 64));
    }

    // Validation Blueprint for UserStudyProgress
    function isValidUserStudyProgress(data) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'streakCount',
          'longestStreak',
          'lastActiveDate',
          'quizHighScore',
          'quizAttempts',
          'masteredIds',
          'bookmarkedIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'displayName',
          'streakCount',
          'longestStreak',
          'lastActiveDate',
          'quizHighScore',
          'quizAttempts',
          'masteredIds',
          'bookmarkedIds',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.streakCount is int
        && data.streakCount >= 1
        && data.streakCount <= 10000
        && data.longestStreak is int
        && data.longestStreak >= 1
        && data.longestStreak <= 10000
        && data.lastActiveDate is string
        && data.lastActiveDate.size() == 10
        && data.lastActiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.quizHighScore is int
        && data.quizHighScore >= 0
        && data.quizHighScore <= 100
        && data.quizAttempts is int
        && data.quizAttempts >= 0
        && data.quizAttempts <= 100000
        && isValidStringArray(data.masteredIds)
        && isValidStringArray(data.bookmarkedIds)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Per-User Study Progress & Streak Collection
    match /userStudyProgress/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserStudyProgress(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (
        isSignedIn()
        && isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserStudyProgress(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Sync Study Progress & Daily Streak
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'streakCount',
            'longestStreak',
            'lastActiveDate',
            'quizHighScore',
            'quizAttempts',
            'masteredIds',
            'bookmarkedIds',
            'updatedAt'
          ])
        )
      );

      allow delete: if isSignedIn() && isVerifiedUser() && isValidId(userId) && isOwner(userId);
    }
  }
}
